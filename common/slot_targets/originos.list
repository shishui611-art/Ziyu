# originos —— 按分区组织
#
# ★ 2026-10-17：改成**分区**格式。分区的作用：
#   开关（保留锁屏时钟字体 / 保留日韩 / 保留特殊槽）只需要决定"读哪个分区"，
#   不用再去遍历字体配置、扫描目录 —— 切换开关能做到零扫描。
#
# 分区标记格式：单独一行的 [分区名]
#   没有分区标记的老清单会被当成整份 [base]（向后兼容）。
#
# 分区列表：
#
# 分区（开关只决定读不读某个分区，不用扫描）：
#   [main]    主力字体（中/英/数字）—— 永远读
#   [clock]   时钟字体 —— 「保留锁屏时钟」开着时不读
#   [theme]   主题字体（圆体/方体/衬线/斜体/等宽/装饰）
#   [cjk]     中文（繁中/兰亭）
#   [kana]    日文     [hangul] 韩文
#   [lang]    其它文字（阿拉伯/希伯来/泰文…）

[clock]
AndroidClock.ttf
VivoClock.ttf
[main]
GoogleSans-Bold.ttf
GoogleSans-Medium.ttf
GoogleSans-Regular.ttf
GoogleSans-SemiBold.ttf
GoogleSansFlex-Regular.ttf
GoogleSansText-Bold.ttf
GoogleSansText-Medium.ttf
GoogleSansText-Regular.ttf
GoogleSansText-SemiBold.ttf
NotoSans-Regular.ttf
OriginSans-Regular.ttf
Roboto-Black.ttf
Roboto-Bold.ttf
Roboto-ExtraBold.ttf
Roboto-ExtraLight.ttf
Roboto-Light.ttf
Roboto-Medium.ttf
Roboto-Regular.ttf
Roboto-SemiBold.ttf
Roboto-Thin.ttf
RobotoFlex-Regular.ttf
RobotoStatic-Regular.ttf
VivoSans-Bold.ttf
VivoSans-Light.ttf
VivoSans-Medium.ttf
VivoSans-Regular.ttf
VivoSans-SemiBold.ttf
VivoSans-Thin.ttf
VivoSansVF.ttf
iQOOSans-Regular.ttf
vivoSans-Regular.ttf
VivoFont.ttf
vivofont.ttf
[theme]
VivoSansCondensed-Bold.ttf
VivoSansCondensed-Medium.ttf
VivoSansCondensed-Regular.ttf
